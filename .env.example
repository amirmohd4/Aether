# Aether GovOS MVP environment
# Development/staging: deterministic synthetic government execution
AETHER_ENV=staging
AETHER_AUTH_MODE=supabase
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AETHER_ENCRYPTION_KEY=
AETHER_DOCUMENT_BUCKET=aether-documents
AETHER_MAX_DOCUMENT_BYTES=15728640
AETHER_RATE_LIMIT_PER_MINUTE=300
AETHER_ENABLE_LEGACY_API=false

# Optional real connectors. Keep false until every connector is authorized.
AETHER_ENABLE_PRODUCTION_CONNECTORS=false
AETHER_PRODUCTION_CONNECTORS={}

# Optional external OCR provider
AETHER_OCR_BASE_URL=
AETHER_OCR_TOKEN=

# Optional notification delivery
AETHER_NOTIFICATION_WEBHOOK_URL=

# Optional payment provider
AETHER_PAYMENT_PROVIDER_URL=
AETHER_PAYMENT_PROVIDER_TOKEN=

# Frontend (Netlify)
VITE_API_URL=
VITE_REQUIRE_AUTH=true
